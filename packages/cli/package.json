{
  "name": "beziera",
  "version": "0.1.0",
  "description": "Start the Beziera canvas for a design folder, and print the MCP registration for your coding agent. Run with npx beziera [folder].",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "beziera": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "test": "node --test dist"
  },
  "dependencies": {
    "@beziera/canvas": "^0.1.0",
    "@beziera/core": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^22.20.2"
  }
}
